<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PixelPaint.Controls"
        mc:Ignorable="d" d:DesignWidth="816" d:DesignHeight="538"
        x:Class="PixelPaint.Views.EditWindow"
        Title="PixelPaint"
        Width="816" Height="538"
        Icon="/Assets/Icon.ico">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Common RadioButton style to preserve original color when hovered -->
        <Style Selector="RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[RadioButton].Background} " />
            <Setter Property="Foreground" Value="{Binding $parent[RadioButton].Foreground} " />
            <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Radio button indicator -->
                        <Panel Width="16" Height="16">
                            <Rectangle Name="OuterEllipse"
                                       Width="14" Height="14"
                                       Stroke="Gray"
                                       StrokeThickness="1"
                                       Fill="Transparent" />
                            <Rectangle Name="InnerEllipse"
                                       Width="8" Height="8"
                                       Margin="3"
                                       IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                       Fill="{DynamicResource SystemAccentColor}" />
                        </Panel>

                        <!-- Background container -->
                        <Grid Margin="2 0">
                            <Rectangle Name="bgRect"
                                       Width="64"
                                       Height="24"
                                       RadiusX="3"
                                       RadiusY="3"
                                       Fill="{TemplateBinding Background}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Window">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel>
            <!-- Menu -->
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Datei">
                    <MenuItem Name="OpenMenuItem" Header="Öffnen" />
                    <MenuItem Name="SaveMenuItem" Header="Speichern" />
                    <MenuItem Name="SaveAsMenuItem" Header="Speichern unter..." />
                    <MenuItem Name="ResetMenuItem" Header="Reset" />
                    <MenuItem Name="PixelSizeMenuItem" Header="Pixel Grösse.." />
                    <MenuItem Name="ExportMenuItem" Header="Exportieren..." />
                </MenuItem>
                <MenuItem Header="Bearbeiten">
                    <MenuItem Name="UndoMenuItem" Header="Rückgängig" />
                    <MenuItem Name="RedoMenuItem" Header="Wiederholen" />
                </MenuItem>
            </Menu>

            <!-- Main Content -->
            <Grid Margin="12" ColumnDefinitions="120,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Margin="0,19,0,0" Width="120" Spacing="6">
                    <!-- Color Radio Buttons -->
                    <RadioButton GroupName="ColorSelector" Content="Schwarz"
                                 IsChecked="True"
                                 Background="Black"
                                 Foreground="White"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="Weiss"
                                 Background="White"
                                 Foreground="Black"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="Grün"
                                 Background="Lime"
                                 Foreground="Black"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="Gelb"
                                 Background="Yellow"
                                 Foreground="Black"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="Blau"
                                 Background="Blue"
                                 Foreground="White"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="Rot"
                                 Background="Red"
                                 Foreground="White"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />

                    <!-- Other Color Option -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Name="OtherColorRadioButton" GroupName="ColorSelector" Content="andere"
                                     IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                        <Button Name="BrowseColorsButton" Content="..."
                                Width="28"
                                Height="30" />
                    </StackPanel>

                    <Separator Margin="0,12,0,4" />

                    <TextBlock Text="Bildgrösse" FontWeight="Bold" />
                    <TextBlock Name="ImageSizeTextBlock" Text="32 × 16" />

                    <TextBlock Text="Zoom" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Name="ZoomTextBlock" Text="100 %" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Name="ZoomOutButton" Content="-" Width="28" />
                        <Button Name="ZoomResetButton" Content="100 %" MinWidth="52" />
                        <Button Name="ZoomInButton" Content="+" Width="28" />
                    </StackPanel>

                    <Button Name="ZoomFitButton" Content="Einpassen" />

                    <TextBlock Text="Pinselgrösse" FontWeight="Bold" Margin="0,8,0,0" />
                    <Slider Name="BrushSizeSlider"
                            Minimum="1"
                            Maximum="256"
                            Value="1"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True" />
                    <TextBlock Name="BrushSizeTextBlock" Text="1 px" />

                    <!-- Show Grid Lines Option -->
                    <CheckBox Name="ShowGridLinesCheckBox" Content="Gitter anzeigen" IsChecked="True" Margin="0,8,0,0" />
                    
                    <!-- Tool Radio Buttons -->
                    <RadioButton GroupName="ToolSelector" Content="Pinsel"
                                 IsChecked="True"
                                 IsCheckedChanged="OnBrushToolRadioButtonIsCheckedChanged" />
                    
                    <RadioButton GroupName="ToolSelector" Content="Eimer"
                                 IsCheckedChanged="OnFillToolRadioButtonIsCheckedChanged" />
                    
                    <RadioButton GroupName="ToolSelector" Content="Pipette"
                                 IsCheckedChanged="OnPipetteToolRadioButtonIsCheckedChanged" />

                </StackPanel>

                <!-- Image Panel -->
                <Border Grid.Column="1"
                        Name="EditorBorder"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Margin="0,19,0,0"
                        Background="#202020"
                        Padding="8">
                    <ScrollViewer Name="EditorScrollViewer"
                                  UseLayoutRounding="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.GestureRecognizers>
                            <PinchGestureRecognizer />
                        </ScrollViewer.GestureRecognizers>
                        <controls:PixelCanvas Name="PixelCanvas"
                                              Background="White"
                                              ShowGridLines="True"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              UseLayoutRounding="True" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>