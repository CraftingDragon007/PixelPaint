<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PixelPaint.Controls"
        xmlns:loc="clr-namespace:PixelPaint.Localization"
        mc:Ignorable="d" d:DesignWidth="816" d:DesignHeight="538"
        x:Class="PixelPaint.Views.EditWindow"
        Title="{loc:Loc App_Title}"
        Width="816" Height="538"
        MinWidth="640" MinHeight="420"
        Icon="/Assets/Icon.ico">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Common RadioButton style to preserve original color when hovered -->
        <Style Selector="RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[RadioButton].Background} " />
            <Setter Property="Foreground" Value="{Binding $parent[RadioButton].Foreground} " />
            <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Radio button indicator -->
                        <Panel Width="16" Height="16">
                            <Rectangle Name="OuterEllipse"
                                       Width="14" Height="14"
                                       Stroke="Gray"
                                       StrokeThickness="1"
                                       Fill="Transparent" />
                            <Rectangle Name="InnerEllipse"
                                       Width="8" Height="8"
                                       Margin="3"
                                       IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                       Fill="{DynamicResource SystemAccentColor}" />
                        </Panel>

                        <!-- Background container -->
                        <Grid Margin="2 0">
                            <Rectangle Name="bgRect"
                                       Width="64"
                                       Height="24"
                                       RadiusX="3"
                                       RadiusY="3"
                                       Fill="{TemplateBinding Background}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Window">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel>
            <!-- Menu -->
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="{loc:Loc Menu_File}">
                    <MenuItem Name="OpenMenuItem" Header="{loc:Loc Menu_File_Open}" />
                    <MenuItem Name="ImportMenuItem" Header="{loc:Loc Menu_File_Import}" />
                    <MenuItem Name="SaveMenuItem" Header="{loc:Loc Menu_File_Save}" />
                    <MenuItem Name="SaveAsMenuItem" Header="{loc:Loc Menu_File_SaveAs}" />
                    <MenuItem Name="ResetMenuItem" Header="{loc:Loc Menu_File_Reset}" />
                    <MenuItem Name="PixelSizeMenuItem" Header="{loc:Loc Menu_File_PixelSize}" />
                    <MenuItem Name="ExportMenuItem" Header="{loc:Loc Menu_File_Export}" />
                </MenuItem>
                <MenuItem Header="{loc:Loc Menu_Edit}">
                    <MenuItem Name="UndoMenuItem" Header="{loc:Loc Menu_Edit_Undo}" />
                    <MenuItem Name="RedoMenuItem" Header="{loc:Loc Menu_Edit_Redo}" />
                </MenuItem>
                <MenuItem Name="LanguageMenuItem" Header="{loc:Loc Menu_Language}" />
            </Menu>

            <!-- Main Content -->
            <Grid Margin="12" ColumnDefinitions="150,*" ColumnSpacing="16">
                <ScrollViewer Grid.Column="0"
                              Margin="0,19,0,0"
                              Width="150"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                    <!-- Color Radio Buttons -->
                    <RadioButton GroupName="ColorSelector" Content="{loc:Loc Color_Black}"
                                 IsChecked="True"
                                 Background="Black"
                                 Foreground="White"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="{loc:Loc Color_White}"
                                 Background="White"
                                 Foreground="Black"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="{loc:Loc Color_Green}"
                                 Background="Lime"
                                 Foreground="Black"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="{loc:Loc Color_Yellow}"
                                 Background="Yellow"
                                 Foreground="Black"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="{loc:Loc Color_Blue}"
                                 Background="Blue"
                                 Foreground="White"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                    <RadioButton GroupName="ColorSelector" Content="{loc:Loc Color_Red}"
                                 Background="Red"
                                 Foreground="White"
                                 IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />

                    <!-- Other Color Option -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Name="OtherColorRadioButton" GroupName="ColorSelector" Content="{loc:Loc Color_Other}"
                                     IsCheckedChanged="OnColorRadioButtonIsCheckedChanged" />
                        <Button Name="BrowseColorsButton" Content="..."
                                Width="28"
                                Height="30" />
                    </StackPanel>

                    <Separator Margin="0,12,0,4" />

                    <TextBlock Text="{loc:Loc Label_ImageSize}" FontWeight="Bold" />
                    <TextBlock Name="ImageSizeTextBlock" Text="32 × 16" />

                    <TextBlock Text="{loc:Loc Label_Zoom}" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Name="ZoomTextBlock" Text="100 %" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Name="ZoomOutButton" Content="-" Width="28" />
                        <Button Name="ZoomResetButton" Content="{loc:Loc Button_ZoomReset}" MinWidth="52" />
                        <Button Name="ZoomInButton" Content="+" Width="28" />
                    </StackPanel>

                    <Button Name="ZoomFitButton" Content="{loc:Loc Button_ZoomFit}" />

                    <TextBlock Text="{loc:Loc Label_BrushSize}" FontWeight="Bold" Margin="0,8,0,0" />
                    <Slider Name="BrushSizeSlider"
                            Minimum="1"
                            Maximum="256"
                            Value="1"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            MaxWidth="120" />
                    <TextBlock Name="BrushSizeTextBlock" Text="1 px" />

                    <!-- Show Grid Lines Option -->
                    <CheckBox Name="ShowGridLinesCheckBox" Content="{loc:Loc Label_ShowGridLines}" IsChecked="True" Margin="0,8,0,0" />
                    
                    <!-- Tool Radio Buttons -->
                    <RadioButton GroupName="ToolSelector" Content="{loc:Loc Tool_Brush}"
                                 IsChecked="True"
                                 IsCheckedChanged="OnBrushToolRadioButtonIsCheckedChanged" />
                    
                    <RadioButton GroupName="ToolSelector" Content="{loc:Loc Tool_Fill}"
                                 IsCheckedChanged="OnFillToolRadioButtonIsCheckedChanged" />
                    
                    <RadioButton GroupName="ToolSelector" Content="{loc:Loc Tool_Pipette}"
                                 IsCheckedChanged="OnPipetteToolRadioButtonIsCheckedChanged" />

                    </StackPanel>
                </ScrollViewer>

                <!-- Image Panel -->
                <Border Grid.Column="1"
                        Name="EditorBorder"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Margin="0,19,0,0"
                        Background="#202020"
                        Padding="8">
                    <ScrollViewer Name="EditorScrollViewer"
                                  UseLayoutRounding="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.GestureRecognizers>
                            <PinchGestureRecognizer />
                        </ScrollViewer.GestureRecognizers>
                        <controls:PixelCanvas Name="PixelCanvas"
                                              ShowGridLines="True"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              UseLayoutRounding="True" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>