<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
        x:Class="PixelPaint.Views.ColorDialog"
        Title="Pick a Color" Width="500" Height="450"
        Icon="/Assets/Icon.ico"
        CanResize="False">


    <StackPanel>
        <ColorView VerticalAlignment="Stretch" Name="ColorPicker" IsAlphaVisible="False" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Margin="10" Name="OkButton" Content="OK" Height="30" Click="OkButton_Click" />
            <Button Margin="10" Name="CancelButton" Content="Cancel" Height="30" Click="CancelButton_Click" />
        </WrapPanel>
    </StackPanel>

</Window>